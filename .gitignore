# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
dist/
build/

# Mahoraga runtime output — eval runs, sandboxes, and any fetched specs/diffs are
# per-project, potentially proprietary, and MUST NOT be committed (see SECURITY.md).
eval-run/
*-runs/
sandboxes/
# project configs may carry credentials/answer tokens — keep local
*.local.yaml
SPEC.md.fetched
BUSINESS_REQUIREMENT.md.fetched

# Secrets / credentials — never commit
*.settings.xml
.env
.env.*
*.pem
*.key

# The private leak-scan list names an organisation: it must never be committed.
leak-scan.extra
*.extra
